  {
   "_id": "0u6UrVCKfLGGE9lV",
   "name": "Vengeful Glare",
   "type": "feat",
   "img": "systems/dnd5e/icons/svg/items/feature.svg",
   "system": {
    "type": {
     "value": "monster",
     "subtype": ""
    },
    "description": {
     "value": "<p>The revenant targets one creature it can see within 30 feet of it and against which it has sworn vengeance. The target must make a [[/save wis 15]]{DC 15} Wisdom saving throw. On a failure, the target is &amp;Reference[condition=paralyzed]{paralyzed} until the revenant deals damage to it, or until the end of the revenant's next turn. When the paralysis ends, the target is &amp;Reference[condition=frightened]{frightened} of the revenant for 1 minute. The &amp;Reference[condition=frightened]{frightened} target can repeat the saving throw at the end of each of its turns, with disadvantage if it can see the revenant, ending the &amp;Reference[condition=frightened]{frightened} condition on itself on a success.</p>",
     "chat": ""
    },
